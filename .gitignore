# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
*.egg-info/

# App data / local DB (SQLite runs in WAL mode: -wal/-shm sit next to the .db)
data/*.db
data/*.db-wal
data/*.db-shm
data/*.sqlite
data/*.log

# Scryfall bulk-data exports (multi-GB, fetched by app/bulk_data.py or by hand)
*.jsonl

# Cloudflare credentials (never commit)
*.cloudflared.json
cloudflared/config.yml

# Local secrets / env (never commit) — e.g. MTG_BRAVE_API_KEY
.env

# OS
.DS_Store
